generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Product {
  id               String                 @id @db.Uuid
  name             String                 @db.VarChar(200)
  type             String                 @db.VarChar(20)
  priceMinor       Decimal                @map("price_minor") @db.Decimal
  currency         String                 @default("IRR") @db.VarChar(3)
  subscriptionDays Int?                   @map("subscription_days")
  digitalMetadata  Json?                  @map("digital_metadata")
  active           Boolean                @default(true)
  version          Int                    @default(1)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  inventory        Inventory?
  items            OrderItem[]
  adjustments      InventoryAdjustment[]
  discrepancies    InventoryDiscrepancy[]

  @@map("products")
}

model Inventory {
  productId      String   @id @map("product_id") @db.Uuid
  available      BigInt   @default(0)
  observedOnHand BigInt?  @map("observed_on_hand")
  requiresReview Boolean  @default(false) @map("requires_review")
  version        Int      @default(1)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model InventoryAdjustment {
  id              String   @id @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  actorId         String   @map("actor_id") @db.VarChar(128)
  kind            String   @db.VarChar(20)
  delta           BigInt
  beforeAvailable BigInt   @map("before_available")
  afterAvailable  BigInt   @map("after_available")
  reason          String   @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@map("inventory_adjustments")
}

model InventoryDiscrepancy {
  id                   String   @id @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  countedOnHand        BigInt   @map("counted_on_hand")
  heldQuantity         BigInt   @map("held_quantity")
  shortage             BigInt
  affectedReservations Json     @map("affected_reservations")
  status               String   @default("OPEN") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@map("inventory_discrepancies")
}

model AuditLog {
  id         String   @id @db.Uuid
  actorId    String   @map("actor_id") @db.VarChar(128)
  resourceId String   @map("resource_id") @db.Uuid
  action     String   @db.VarChar(80)
  reason     String   @db.VarChar(1000)
  before     Json?
  after      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceId, createdAt])
  @@map("audit_logs")
}

model CustomerOrder {
  id                    String                    @id @db.Uuid
  customerId            String                    @map("customer_id") @db.VarChar(128)
  status                String                    @default("CHECKOUT_RESERVED") @db.VarChar(40)
  currency              String                    @default("IRR") @db.VarChar(3)
  totalMinor            Decimal                   @map("total_minor") @db.Decimal
  checkoutRevision      Int                       @default(1) @map("checkout_revision")
  checkoutExpiresAt     DateTime?                 @map("checkout_expires_at") @db.Timestamptz(6)
  preparationVersion    Int                       @default(0) @map("preparation_version")
  admissionSlot         AdmissionSlot?
  financialProjection   OrderFinancialProjection?
  paymentOperationKey   String?                   @unique @map("payment_operation_key") @db.VarChar(150)
  paymentEntryRevision  Int?                      @map("payment_entry_revision")
  fulfillmentStartedAt  DateTime?                 @map("fulfillment_started_at") @db.Timestamptz(6)
  workflowVersion       Int                       @default(0) @map("workflow_version")
  paymentVersion        Int                       @default(0) @map("payment_version")
  cancellationRequested Boolean                   @default(false) @map("cancellation_requested")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  items                 OrderItem[]
  revisions             CheckoutRevision[]
  events                OrderEvent[]

  @@index([customerId, createdAt, id])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@map("orders")
}

model OrderItem {
  id                     String          @id @db.Uuid
  orderId                String          @map("order_id") @db.Uuid
  productId              String          @map("product_id") @db.Uuid
  name                   String          @db.VarChar(200)
  type                   String          @db.VarChar(20)
  quantity               Int
  unitPriceMinor         Decimal         @map("unit_price_minor") @db.Decimal
  lineTotalMinor         Decimal         @map("line_total_minor") @db.Decimal
  subscriptionDays       Int?            @map("subscription_days")
  status                 String          @default("PENDING") @db.VarChar(30)
  disposition            String          @default("FULFILL") @db.VarChar(30)
  generation             Int             @default(0)
  attemptCount           Int             @default(0) @map("attempt_count")
  retryVersion           Int             @default(0) @map("retry_version")
  cycleStartAttempt      Int             @default(0) @map("cycle_start_attempt")
  recoveryStartedAt      DateTime?       @map("recovery_started_at") @db.Timestamptz(6)
  infrastructureFailures Int             @default(0) @map("infrastructure_failures")
  nextAttemptAt          DateTime?       @map("next_attempt_at") @db.Timestamptz(6)
  order                  CustomerOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product                Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservations           Reservation[]
  fulfillmentJob         FulfillmentJob?

  @@unique([id, productId])
  @@index([orderId, status])
  @@map("order_items")
}

model CheckoutRevision {
  orderId    String        @map("order_id") @db.Uuid
  version    Int
  snapshot   Json
  totalMinor Decimal       @map("total_minor") @db.Decimal
  confirmed  Boolean       @default(false)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order      CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([orderId, version])
  @@map("checkout_revisions")
}

model Reservation {
  id         String    @id @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  generation Int
  quantity   Int
  status     String    @default("ACTIVE") @db.VarChar(30)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  item       OrderItem @relation(fields: [itemId, productId], references: [id, productId], onDelete: Restrict)

  @@unique([itemId, generation])
  @@index([productId, status])
  @@map("reservations")
}

model OrderEvent {
  id        String        @id @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  type      String        @db.VarChar(80)
  metadata  Json
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt, id])
  @@map("order_events")
}

model ReviewCase {
  id         String   @id @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  reason     String   @db.VarChar(80)
  status     String   @default("OPEN") @db.VarChar(20)
  metadata   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("review_cases")
}

model IdempotencyRecord {
  id          String   @id @db.Uuid
  actorId     String   @map("actor_id") @db.VarChar(128)
  operation   String   @db.VarChar(120)
  key         String   @db.VarChar(128)
  fingerprint String   @db.VarChar(64)
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([actorId, operation, key])
  @@map("idempotency_records")
}

model Outbox {
  id          String    @id @db.Uuid
  kind        String    @db.VarChar(100)
  aggregateId String    @map("aggregate_id") @db.Uuid
  generation  Int
  payload     Json
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  claimToken  String?   @map("claim_token") @db.Uuid
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)

  @@unique([kind, aggregateId, generation])
  @@map("outbox")
}

model ConsumerReceipt {
  consumer  String   @db.VarChar(100)
  messageId String   @map("message_id") @db.Uuid
  handledAt DateTime @default(now()) @map("handled_at") @db.Timestamptz(6)

  @@id([consumer, messageId])
  @@map("consumer_receipts")
}

datasource db {
  provider = "postgresql"
}

model InboxMessage {
  consumer    String   @db.VarChar(100)
  messageId   String   @map("message_id") @db.Uuid
  envelope    Json
  status      String   @default("PENDING") @db.VarChar(20)
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError   String?  @map("last_error") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([consumer, messageId])
  @@map("inbox_messages")
}

model MessageQuarantine {
  id        String   @id @db.Uuid
  consumer  String   @db.VarChar(100)
  reason    String   @db.VarChar(80)
  evidence  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("message_quarantine")
}

model AdmissionBudget {
  id               Int       @id
  capacity         Int
  used             Int       @default(0)
  acceptingNew     Boolean   @default(true) @map("accepting_new")
  storageHealthy   Boolean   @default(false) @map("storage_healthy")
  storageCheckedAt DateTime? @map("storage_checked_at") @db.Timestamptz(6)

  @@map("admission_budget")
}

model AdmissionSlot {
  orderId    String        @id @map("order_id") @db.Uuid
  releasedAt DateTime?     @map("released_at") @db.Timestamptz(6)
  order      CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("admission_slots")
}

model OrderFinancialProjection {
  orderId             String        @id @map("order_id") @db.Uuid
  revision            Int
  operationKey        String?       @map("operation_key") @db.VarChar(150)
  bankReference       String?       @map("bank_reference") @db.VarChar(200)
  bankDeadlineAt      DateTime?     @map("bank_deadline_at") @db.Timestamptz(6)
  sourceVersion       Int           @default(0) @map("source_version")
  status              String        @default("NOT_REQUESTED") @db.VarChar(40)
  pending             Boolean       @default(false)
  refundSourceVersion Int           @default(0) @map("refund_source_version")
  summary             String        @default("NONE") @db.VarChar(30)
  refundedMinor       Decimal       @default(0) @map("refunded_minor") @db.Decimal
  pendingRefundMinor  Decimal       @default(0) @map("pending_refund_minor") @db.Decimal
  updatedAt           DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  order               CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("order_financial_projections")
}

model FulfillmentJob {
  itemId      String    @id @map("item_id") @db.Uuid
  status      String    @default("READY") @db.VarChar(30)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  generation  Int       @default(0)
  item        OrderItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("fulfillment_jobs")
}

// Operational ledger foreign keys/checks are defined in the matching forward SQL migration.
model DigitalEntitlement {
  customerId String   @map("customer_id") @db.VarChar(128)
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([customerId, productId])
  @@map("digital_entitlements")
}

model DigitalGrant {
  itemId     String   @id @map("item_id") @db.Uuid
  customerId String   @map("customer_id") @db.VarChar(128)
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("digital_grants")
}

model Subscription {
  customerId String   @map("customer_id") @db.VarChar(128)
  productId  String   @map("product_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([customerId, productId])
  @@map("subscriptions")
}

model SubscriptionExtension {
  itemId            String    @id @map("item_id") @db.Uuid
  customerId        String    @map("customer_id") @db.VarChar(128)
  productId         String    @map("product_id") @db.Uuid
  days              Int
  previousExpiresAt DateTime? @map("previous_expires_at") @db.Timestamptz(6)
  newExpiresAt      DateTime  @map("new_expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("subscription_extensions")
}

model Shipment {
  itemId        String   @id @map("item_id") @db.Uuid
  reservationId String   @unique @map("reservation_id") @db.Uuid
  reference     String   @unique @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("shipments")
}

model FulfillmentAttempt {
  id        String   @id @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  attempt   Int
  result    String   @db.VarChar(40)
  reason    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([itemId, attempt])
  @@map("fulfillment_attempts")
}

model FulfillmentSimulationRule {
  itemId           String   @id @map("item_id") @db.Uuid
  notBefore        DateTime @default(now()) @map("not_before") @db.Timestamptz(6)
  outcome          String   @default("SUCCESS") @db.VarChar(30)
  failUntilAttempt Int      @default(1) @map("fail_until_attempt")

  @@map("fulfillment_simulation_rules")
}

model ItemRefundDisposition {
  id              String   @id @db.Uuid
  itemId          String   @unique @map("item_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  operationKey    String   @unique @map("operation_key") @db.VarChar(150)
  amountMinor     Decimal  @map("amount_minor") @db.Decimal
  reason          String   @db.VarChar(1000)
  status          String   @default("PENDING") @db.VarChar(30)
  sourceVersion   Int      @default(0) @map("source_version")
  billingRefundId String?  @map("billing_refund_id") @db.Uuid
  bankReference   String?  @map("bank_reference") @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("item_refund_dispositions")
}

model RefundProjectionLog {
  id            String   @id @db.Uuid
  dispositionId String   @map("disposition_id") @db.Uuid
  type          String   @db.VarChar(80)
  metadata      Json
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)

  @@map("refund_projection_logs")
}

model StockDisposition {
  reservationId String   @id @map("reservation_id") @db.Uuid
  dispositionId String   @unique @map("disposition_id") @db.Uuid
  kind          String   @db.VarChar(30)
  actorId       String   @map("actor_id") @db.VarChar(128)
  reason        String   @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("stock_dispositions")
}
